<?xml version="1.0" encoding="UTF-8"?>
<window>
	<zorder>4</zorder>
	<controls>
		<control type="group">
			<visible>!Player.Muted</visible>
			<control type="group">
				<visible>!Player.Passthrough</visible>
				<control type="image" description="Speaker">
					<visible>!Player.Passthrough</visible>
					<left>60</left>
					<top>72</top>
					<width>129</width>
					<height>129</height>
					<texture>OSD/Volume.png</texture>
					<colordiffuse>$VAR[HighlightColor]</colordiffuse>
				</control>
				<control type="progress" id="20">
					<left>-300</left>
					<top>-300</top>
					<width>324</width>
					<height>81</height>
					<texturebg />
					<lefttexture />
					<midtexture />
					<righttexture />
					<info>Player.Volume</info>
				</control>
				<control type="label">
					<left>180</left>
					<top>91</top>
					<width>353</width>
					<height>82</height>
					<font>MainLabelBigTitle</font>
					<label>$INFO[Control.GetLabel(20)]</label>
					<scroll>true</scroll>
				</control>
			</control>
			<control type="group">
				<visible>Player.Passthrough</visible>
				<control type="image" description="Speaker passthrough">
					<visible>Player.Passthrough</visible>
					<left>60</left>
					<top>72</top>
					<width>129</width>
					<height>129</height>
					<texture>OSD/VolumeMuted.png</texture>
					<colordiffuse>$VAR[HighlightColor]</colordiffuse>
				</control>
			</control>
		</control>
		<control type="image" description="Player Muted">
			<left>60</left>
			<top>72</top>
			<width>129</width>
			<height>129</height>
			<texture>OSD/VolumeMuted.png</texture>
			<colordiffuse>Red</colordiffuse>
			<visible>Player.Muted</visible>
		</control>
	</controls>
</window>