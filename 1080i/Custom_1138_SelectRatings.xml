				</control>
				<control type="radiobutton" id="9010110">
					<label>$LOCALIZE[31370]</label>
					<radioposx>605</radioposx>
					<onclick>Skin.ToggleSetting(ShowMPAAVideoInfo)</onclick>
					<selected>Skin.HasSetting(ShowMPAAVideoInfo)</selected>
				</control>
			</control>
		</control>
	</controls>
</window>