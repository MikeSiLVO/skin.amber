<?xml version="1.0" encoding="UTF-8"?>
<window>
	<defaultcontrol always="true">50</defaultcontrol>
	<include>OpenClose</include>
	<controls>
		<include>DimBG</include>
		<control type="group">
			<left>172</left>
			<top>180</top>
			<include content="DetailsDialogFrame">
				<param name="image">$VAR[VideoVersionsPosterVar]</param>
				<param name="list">50</param>
			</include>
			<control type="label" id="2" description="Header">
				<left>-14</left>
				<top>5</top>
				<width>1600</width>
				<height>30</height>
				<align>center</align>
				<aligny>center</aligny>
				<font>ListDetails</font>
				<textcolor>$VAR[HighlightColor]</textcolor>
			</control>
			<control type="list" id="50">
				<left>DetailsListLeft</left>
				<top>60</top>
				<width>DetailsListWidth</width>
				<height>600</height>
				<orientation>vertical</orientation>
				<onleft>60</onleft>
				<onright>90</onright>
				<pagecontrol>60</pagecontrol>
				<scrolltime>0</scrolltime>
				<itemlayout width="860" height="60">
					<control type="image">
						<width>860</width>
						<height>60</height>
						<texture border="3">list/ListNF.png</texture>
					</control>
					<control type="label">
						<left>20</left>
						<width>840</width>
						<height>60</height>
						<label>$INFO[ListItem.Label]</label>
						<scroll>true</scroll>
						<selectedcolor>$VAR[HighlightColor]</selectedcolor>
					</control>
				</itemlayout>
				<focusedlayout width="860" height="60">
					<control type="image">
						<width>860</width>
						<height>60</height>
						<texture border="3">list/ListNF.png</texture>
					</control>
					<control type="image">
						<visible>Control.HasFocus(50)</visible>
						<include>VisibleFadeEffect</include>
						<width>860</width>
						<height>60</height>
						<texture border="4" colordiffuse="$VAR[HighlightColor]">img/WhiteRoundedST2.png</texture>
					</control>
					<control type="label">
						<left>20</left>
						<width>840</width>
						<height>60</height>
						<textcolor>$VAR[FocusedTextColor]</textcolor>
						<selectedcolor>SelectedFocused</selectedcolor>
						<shadowcolor>HeavyShadow</shadowcolor>
						<label>$INFO[ListItem.Label]</label>
						<scroll>true</scroll>
					</control>
				</focusedlayout>
			</control>
			<control type="grouplist" id="90">
				<top>60</top>
				<left>DetailsButtonsLeft</left>
				<onleft>50</onleft>
				<onright>50</onright>
				<control type="button" id="21">
					<description>Play button</description>
					<width>DetailsButtonWidth</width>
					<height>60</height>
					<label>$LOCALIZE[208]</label>
					<align>right</align>
					<texturenofocus border="3">buttons/ButtonNF.png</texturenofocus>
				</control>
				<control type="button" id="22">
					<description>Add version button</description>
					<width>DetailsButtonWidth</width>
					<height>60</height>
					<label>$LOCALIZE[40014]</label>
					<align>right</align>
					<texturenofocus border="3">buttons/ButtonNF.png</texturenofocus>
					<visible>Window.IsVisible(managevideoversions)</visible>
				</control>
				<control type="button" id="23">
					<description>Add extras button</description>
					<width>DetailsButtonWidth</width>
					<height>60</height>
					<label>$LOCALIZE[40015]</label>
					<align>right</align>
					<texturenofocus border="3">buttons/ButtonNF.png</texturenofocus>
					<visible>Window.IsVisible(managevideoextras)</visible>
				</control>
				<control type="button" id="27">
					<description>Choose art button</description>
					<width>DetailsButtonWidth</width>
					<height>60</height>
					<label>$LOCALIZE[13511]</label>
					<align>right</align>
					<texturenofocus border="3">buttons/ButtonNF.png</texturenofocus>
				</control>
				<control type="button" id="24">
					<description>Choose version type button</description>
					<width>DetailsButtonWidth</width>
					<height>60</height>
					<label>$LOCALIZE[40004]</label>
					<align>right</align>
					<texturenofocus border="3">buttons/ButtonNF.png</texturenofocus>
					<visible>Window.IsVisible(managevideoversions)</visible>
				</control>
				<control type="button" id="28">
					<description>Rename extra button</description>
					<width>DetailsButtonWidth</width>
					<height>60</height>
					<label>$LOCALIZE[118]</label>
					<align>right</align>
					<texturenofocus border="3">buttons/ButtonNF.png</texturenofocus>
					<visible>Window.IsVisible(managevideoextras)</visible>
				</control>
				<control type="button" id="26">
					<description>Remove button</description>
					<width>DetailsButtonWidth</width>
					<height>60</height>
					<label>$LOCALIZE[15015]</label>
					<align>right</align>
					<texturenofocus border="3">buttons/ButtonNF.png</texturenofocus>
				</control>
				<control type="button" id="29">
					<description>Ungroup version button</description>
					<width>DetailsButtonWidth</width>
					<height>60</height>
					<label>$LOCALIZE[40046]</label>
					<align>right</align>
					<texturenofocus border="3">buttons/ButtonNF.png</texturenofocus>
					<visible>Window.IsVisible(managevideoversions)</visible>
				</control>
				<control type="button" id="25">
					<description>Set default button</description>
					<width>DetailsButtonWidth</width>
					<height>60</height>
					<label>$LOCALIZE[40023]</label>
					<align>right</align>
					<texturenofocus border="3">buttons/ButtonNF.png</texturenofocus>
					<visible>Window.IsVisible(managevideoversions)</visible>
				</control>
			</control>
		</control>
	</controls>
</window>