<?xml version="1.0" encoding="UTF-8"?>
<includes>
	<!-- Custom TV Guide Includes - Uses Skin Info Service -->
	<!-- Use landscape if available for thumb, if not, use fanart -->
	<variable name="NextAiredTVGuideArt">
		<value condition="!String.IsEmpty(ListItem.Art(landscape))">$INFO[ListItem.Art(landscape)]</value>
		<value condition="String.IsEmpty(ListItem.Art(landscape))">$INFO[ListItem.Art(fanart)]</value>
	</variable>
	<!-- Left List item for Next Aired -->
	<include name="TMDbTVGuideItem">
		<param name="TMDbTVGuideItemID" />
		<param name="TMDbTVGuideDayID" />
		<definition>
			<item id="$PARAM[TMDbTVGuideItemID]">
				<label>$INFO[Container($PARAM[TMDbTVGuideDayID]).ListItemAbsolute(0).Property(AirDay)]$INFO[Container($PARAM[TMDbTVGuideDayID]).NumItems, (,)]</label>
				<label2>$INFO[Container($PARAM[TMDbTVGuideDayID]).ListItemAbsolute(0).Property(AirDate)]</label2>
				<visible>Integer.IsGreater(Container($PARAM[TMDbTVGuideDayID]).NumItems,0) | Container($PARAM[TMDbTVGuideDayID]).IsUpdating | Container(4000).IsUpdating</visible>
			</item>
		</definition>
	</include>
	<!-- Episode Panel layout for Next Aired -->
	<include name="TMDbTVGuidePanelLayout">
		<left>500</left>
		<top>120</top>
		<width>1341</width>
		<height>910</height>
		<onup>60</onup>
		<ondown>60</ondown>
		<onleft>4000</onleft>
		<orientation>horizontal</orientation>
		<scrolltime tween="quadratic">300</scrolltime>
		<pagecontrol>60</pagecontrol>
		<itemlayout height="840" width="447">
			<control type="image">
				<top>20</top>
				<width>445</width>
				<height>237</height>
				<aspectratio aligny="top">keep</aspectratio>
				<texture background="true">$VAR[NextAiredTVGuideArt]</texture>
			</control>
			<control type="label">
				<top>260</top>
				<width>425</width>
				<height>45</height>
				<label>$INFO[ListItem.TVShowTitle]</label>
				<textoffsetx>15</textoffsetx>
				<font>InfoTitle</font>
				<textcolor>$VAR[HighlightColor]</textcolor>
			</control>
			<control type="label">
				<top>360</top>
				<width>425</width>
				<height>45</height>
				<label>$LOCALIZE[31060]:</label>
				<textoffsetx>15</textoffsetx>
				<font>InfoTitle</font>
				<textcolor>$VAR[HighlightColor]</textcolor>
			</control>
			<control type="label">
				<top>410</top>
				<width>425</width>
				<height>45</height>
				<label>[COLOR $VAR[HighlightColor]]$LOCALIZE[20373]:[/COLOR] [B][COLOR $VAR[LabelTextColor]]$INFO[ListItem.Season][/COLOR][/B]  [COLOR $VAR[HighlightColor]]$LOCALIZE[20359]:[/COLOR] [B][COLOR Grey2]$INFO[ListItem.Episode][/COLOR][/B]</label>
				<textoffsetx>15</textoffsetx>
				<font>InfoPlot</font>
			</control>
			<control type="textbox">
				<left>20</left>
				<top>460</top>
				<width>425</width>
				<height>90</height>
				<label>[COLOR $VAR[LabelTextColor]]$INFO[ListItem.Title][/COLOR]</label>
				<autoscroll>false</autoscroll>
				<shadowcolor />
			</control>
			<control type="textbox">
				<left>20</left>
				<top>545</top>
				<width>425</width>
				<height>100</height>
				<label>$INFO[ListItem.Plot]</label>
				<autoscroll>false</autoscroll>
				<shadowcolor />
				<font>InfoPlotSmall</font>
			</control>
			<control type="label">
				<top>650</top>
				<width>445</width>
				<height>45</height>
				<label>$LOCALIZE[126]:</label>
				<textoffsetx>15</textoffsetx>
				<font>InfoTitle</font>
				<textcolor>$VAR[HighlightColor]</textcolor>
			</control>
			<control type="label">
				<top>695</top>
				<width>445</width>
				<height>45</height>
				<label>$INFO[ListItem.Status]</label>
				<textoffsetx>15</textoffsetx>
				<font>InfoPlot</font>
			</control>
			<control type="label">
				<top>745</top>
				<width>445</width>
				<height>45</height>
				<label>$LOCALIZE[31062]:</label>
				<textoffsetx>15</textoffsetx>
				<font>InfoTitle</font>
				<textcolor>$VAR[HighlightColor]</textcolor>
			</control>
			<control type="label">
				<top>790</top>
				<width>445</width>
				<height>45</height>
				<label>$INFO[ListItem.Property(AirTime)]$INFO[ListItem.Studio, @ ]</label>
				<textoffsetx>15</textoffsetx>
				<font>InfoPlot</font>
			</control>
		</itemlayout>
		<focusedlayout height="840" width="447">
			<control type="image" description="fa overlay">
				<width>447</width>
				<height>840</height>
				<texture border="4" colordiffuse="$VAR[HighlightColor]">img/WhiteRoundedST2.png</texture>
				<visible>ControlGroup(5000).HasFocus()</visible>
			</control>
			<control type="image">
				<top>20</top>
				<width>445</width>
				<height>237</height>
				<aspectratio aligny="top">keep</aspectratio>
				<texture background="true">$VAR[NextAiredTVGuideArt]</texture>
			</control>
			<control type="label">
				<top>260</top>
				<width>425</width>
				<height>45</height>
				<label>[B]$INFO[ListItem.TVShowTitle][/B]</label>
				<textoffsetx>15</textoffsetx>
				<font>InfoTitle</font>
				<textcolor>$VAR[FocusedTextColor]</textcolor>
			</control>
			<control type="label">
				<top>360</top>
				<width>425</width>
				<height>45</height>
				<label>[B]$LOCALIZE[31060]:[/B]</label>
				<textoffsetx>15</textoffsetx>
				<font>InfoTitle</font>
				<textcolor>$VAR[FocusedTextColor]</textcolor>
			</control>
			<control type="label">
				<top>410</top>
				<width>425</width>
				<height>45</height>
				<label>[B]$LOCALIZE[20373]: $INFO[ListItem.Season]  $LOCALIZE[20359]: $INFO[ListItem.Episode][/B]</label>
				<textoffsetx>15</textoffsetx>
				<font>InfoPlot</font>
				<textcolor>$VAR[FocusedTextColor]</textcolor>
			</control>
			<control type="textbox">
				<left>20</left>
				<top>460</top>
				<width>425</width>
				<height>90</height>
				<label>$INFO[ListItem.Title]</label>
				<autoscroll>false</autoscroll>
				<shadowcolor />
				<textcolor>$VAR[FocusedTextColor]</textcolor>
			</control>
			<control type="textbox">
				<left>20</left>
				<top>545</top>
				<width>425</width>
				<height>100</height>
				<label>$INFO[ListItem.Plot]</label>
				<autoscroll>false</autoscroll>
				<shadowcolor />
				<font>InfoPlotSmall</font>
				<textcolor>$VAR[FocusedTextColor]</textcolor>
			</control>
			<control type="label">
				<top>650</top>
				<width>445</width>
				<height>45</height>
				<label>[B]$LOCALIZE[126]:[/B]</label>
				<textoffsetx>15</textoffsetx>
				<font>InfoTitle</font>
				<textcolor>$VAR[FocusedTextColor]</textcolor>
			</control>
			<control type="label">
				<top>695</top>
				<width>445</width>
				<height>45</height>
				<label>$INFO[ListItem.Status]</label>
				<textoffsetx>15</textoffsetx>
				<textcolor>$VAR[FocusedTextColor]</textcolor>
				<font>InfoPlot</font>
			</control>
			<control type="label">
				<top>745</top>
				<width>445</width>
				<height>45</height>
				<label>[B]$LOCALIZE[31062]:[/B]</label>
				<textoffsetx>15</textoffsetx>
				<font>InfoTitle</font>
				<textcolor>$VAR[FocusedTextColor]</textcolor>
			</control>
			<control type="label">
				<top>790</top>
				<width>445</width>
				<height>45</height>
				<label>$INFO[ListItem.Property(AirTime)]$INFO[ListItem.Studio, @ ]</label>
				<textcolor>$VAR[FocusedTextColor]</textcolor>
				<textoffsetx>15</textoffsetx>
				<font>InfoPlot</font>
			</control>
		</focusedlayout>
	</include>
</includes>